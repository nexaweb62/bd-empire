---
interface Props {
  title: string;
  price: string;
  oldPrice?: string;
  badge?: string;
}
const { title, price, oldPrice, badge } = Astro.props;
---
<style>
.p-card{position:relative;border:none;background:transparent}
.p-cover{aspect-ratio:1/1;background:var(--panel);position:relative;overflow:hidden}
.p-badge{position:absolute;top:12px;right:12px;background:var(--accent-2);color:#141311;font-size:.66rem;font-weight:600;padding:5px 11px;letter-spacing:.03em}
.p-body{padding:14px 2px 0}
.p-title{font-size:.9rem;font-weight:500;line-height:1.3}
.p-price-row{display:flex;align-items:center;gap:8px;margin-top:6px}
.p-price{font-weight:600;font-size:.9rem}
.p-old{font-size:.82rem;color:var(--text-muted);text-decoration:line-through}
</style>
<article class="p-card">
  <div class="p-cover">
    {badge && <span class="p-badge">{badge}</span>}
  </div>
  <div class="p-body">
    <h3 class="p-title">{title}</h3>
    <div class="p-price-row">
      <span class="p-price">{price}</span>
      {oldPrice && <span class="p-old">{oldPrice}</span>}
    </div>
  </div>
</article>
