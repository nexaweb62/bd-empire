<style>
.announce{height:var(--hdr-bar);background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:500;letter-spacing:.02em;position:relative;text-align:center;padding:0 40px}
.announce svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;position:absolute;top:50%;transform:translateY(-50%);opacity:.7}
.announce .prev{left:16px}
.announce .next{right:16px}

.site-hdr{position:sticky;top:0;left:0;right:0;z-index:100;height:calc(var(--hdr) - var(--hdr-bar));display:flex;align-items:center;background:var(--bg);border-bottom:1px solid var(--border)}
.hdr-in{width:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px}
.nav{display:flex;align-items:center;gap:28px}
.nav a{font-size:.82rem;font-weight:500;color:var(--text);transition:color .2s}
.nav a:hover{color:var(--text-muted)}
.logo{text-align:center;font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:1.05rem;letter-spacing:.02em;line-height:1.1}
.logo span{display:block;font-size:.6rem;font-family:'Inter',sans-serif;font-weight:600;letter-spacing:.28em;color:var(--text-muted);margin-top:2px}
.hdr-actions{display:flex;align-items:center;justify-content:flex-end;gap:22px}
.lang{display:flex;align-items:center;gap:5px;font-size:.8rem;color:var(--text)}
.lang svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}
.cart-wrap{position:relative}
.cart-badge{position:absolute;top:-7px;right:-9px;background:var(--accent);color:#fff;border-radius:999px;font-size:.62rem;font-weight:700;width:16px;height:16px;display:flex;align-items:center;justify-content:center}
@media(max-width:900px){.nav{display:none}.hdr-in{grid-template-columns:1fr auto 1fr}}
</style>
<div class="announce">
  <svg class="prev" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
  Livraison gratuite dès 250€ d'achat
  <svg class="next" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
</div>
<header class="site-hdr">
  <div class="wrap hdr-in">
    <nav class="nav">
      <a href="/">Accueil</a>
      <a href="/catalogue">Catalogue</a>
      <a href="/contact">Contact</a>
      <a href="/">BD EMPIRES</a>
    </nav>

    <a href="/" class="logo">BD EMPIRE<span>BY BD EMPIRE</span></a>

    <div class="hdr-actions">
      <button type="button" class="lang">
        Français
        <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <button type="button" class="icon-btn" aria-label="Rechercher">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <a href="/contact" class="icon-btn" aria-label="Mon compte">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/panier" class="icon-btn cart-wrap" aria-label="Panier">
        <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-badge">0</span>
      </a>
    </div>
  </div>
</header>
