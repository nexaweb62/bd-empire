<style>
.site-ftr{border-top:1px solid var(--border);background:var(--bg-alt);padding:56px 0 28px}
.ftr-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}
.ftr-logo{font-family:'Playfair Display',Georgia,serif;font-size:1.2rem;font-weight:700}
.ftr-tag{color:var(--text-muted);font-size:.85rem;margin-top:12px;max-width:320px;line-height:1.6}
.ftr-title{font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:14px}
.ftr-links{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.ftr-links a{font-size:.86rem;color:var(--text);transition:color .2s}
.ftr-links a:hover{color:var(--text-muted)}
.ftr-bottom{margin-top:44px;padding-top:22px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:.76rem;color:var(--text-muted)}
@media(max-width:700px){.ftr-grid{grid-template-columns:1fr}.ftr-bottom{flex-direction:column;gap:8px}}
</style>
<footer class="site-ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div>
        <div class="ftr-logo">BD EMPIRE</div>
        <p class="ftr-tag">Vêtements, sneakers et accessoires streetwear — sélection et livraison depuis la France.</p>
      </div>
      <div>
        <div class="ftr-title">Catalogue</div>
        <ul class="ftr-links">
          <li><a href="/catalogue">Tous les articles</a></li>
          <li><a href="/panier">Mon panier</a></li>
        </ul>
      </div>
      <div>
        <div class="ftr-title">Infos</div>
        <ul class="ftr-links">
          <li><a href="/contact">Contact</a></li>
          <li><a href="/">Livraison & retours</a></li>
          <li><a href="/">Mentions légales</a></li>
        </ul>
      </div>
    </div>
    <div class="ftr-bottom">
      <span>© 2026 BD EMPIRE. Tous droits réservés.</span>
      <span>Maquette réalisée par Nexa Web</span>
    </div>
  </div>
</footer>
