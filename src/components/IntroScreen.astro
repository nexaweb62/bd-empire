<style>
#intro{
  position:fixed;inset:0;z-index:1000;
  background:#000;
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  transition:opacity .5s var(--ease);
}
#intro.fade-out{opacity:0;pointer-events:none}
#intro canvas{position:absolute;inset:0;width:100%;height:100%}
.intro-content{position:relative;z-index:2;text-align:center;color:#fff;padding:24px;transition:opacity .3s var(--ease),transform .3s var(--ease)}
.intro-content.hide{opacity:0;transform:scale(1.08)}
.intro-lockup{display:flex;flex-direction:column;align-items:center;gap:6px}
.intro-lockup .display{font-size:clamp(1.8rem,6vw,3.2rem)}
.intro-lockup .signature{font-size:clamp(1.1rem,3vw,1.6rem);color:#fff}
.intro-tagline{margin-top:26px}
.intro-tagline .eyebrow{letter-spacing:.32em}
.intro-skip{
  position:absolute;bottom:28px;right:28px;z-index:3;
  font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--text-muted);background:none;border:none;cursor:pointer;
}
.intro-skip:hover{color:#fff}
@media(max-width:600px){.intro-skip{bottom:20px;right:20px}}
</style>

<div id="intro" aria-hidden="true">
  <canvas id="intro-canvas"></canvas>
  <div class="intro-content" id="intro-content">
    <div class="intro-lockup">
      <span class="display">BD EMPIRES</span>
      <span class="signature">By La Mentale</span>
    </div>
    <div class="intro-tagline">
      <span class="eyebrow">Work · Respect · Discipline</span>
    </div>
  </div>
  <button type="button" class="intro-skip" id="intro-skip">Passer</button>
</div>

<script>
(function () {
  const SEEN_KEY = 'bdEmpiresIntroSeen';
  const overlay = document.getElementById('intro');
  if (!overlay) return;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const alreadySeen = sessionStorage.getItem(SEEN_KEY) === '1';
  const isHome = window.location.pathname === '/';

  if (reduced || alreadySeen || !isHome) {
    overlay.remove();
    document.documentElement.classList.remove('intro-locked');
    return;
  }

  document.documentElement.classList.add('intro-locked');
  sessionStorage.setItem(SEEN_KEY, '1');

  const canvas = document.getElementById('intro-canvas') as HTMLCanvasElement;
  const content = document.getElementById('intro-content');
  const skipBtn = document.getElementById('intro-skip');
  const ctx = canvas.getContext('2d')!;

  let dpr = Math.min(window.devicePixelRatio || 1, 2);
  let w = 0, h = 0;
  function resize() {
    w = window.innerWidth; h = window.innerHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  const start = performance.now();
  const ZOOM_AT = 3000;
  const EXPLODE_DUR = 700;
  const FADE_DUR = 500;
  let phase: 'globe' | 'zoom' | 'done' = 'globe';
  let phaseStart = start;
  let finished = false;
  let raf = 0;

  // deterministic pseudo-continent mask
  function land(theta: number, phi: number) {
    const v = Math.sin(theta * 2.4 + phi * 3.1) * Math.cos(phi * 4.3 - theta * 1.7)
      + Math.sin(theta * 5.1 - phi * 2.2) * 0.5;
    return v > 0.35;
  }

  const LAT_STEPS = 26;
  const LON_STEPS = 44;

  function drawGlobe(t: number, rotation: number, radius: number, cx: number, cy: number, alpha: number) {
    ctx.save();
    ctx.globalAlpha = alpha;

    // orbital cage — latitude rings
    ctx.strokeStyle = 'rgba(255,255,255,0.14)';
    ctx.lineWidth = 1;
    for (let i = 1; i < 3; i++) {
      const ry = (radius) * (i / 3);
      ctx.beginPath();
      ctx.ellipse(cx, cy, radius, ry, 0, 0, Math.PI * 2);
      ctx.stroke();
    }
    // orbital cage — tilted ellipse ring
    ctx.beginPath();
    ctx.ellipse(cx, cy, radius * 1.18, radius * 0.42, Math.PI / 7, 0, Math.PI * 2);
    ctx.stroke();

    // axis
    ctx.beginPath();
    ctx.moveTo(cx, cy - radius * 1.3);
    ctx.lineTo(cx, cy + radius * 1.3);
    ctx.strokeStyle = 'rgba(255,255,255,0.18)';
    ctx.stroke();

    // sphere outline
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(255,255,255,0.22)';
    ctx.stroke();

    // continents as point scatter
    ctx.fillStyle = '#ffffff';
    for (let la = 0; la < LAT_STEPS; la++) {
      const phi = (la / (LAT_STEPS - 1)) * Math.PI - Math.PI / 2;
      const ringRadius = Math.cos(phi);
      const y = Math.sin(phi);
      for (let lo = 0; lo < LON_STEPS; lo++) {
        const theta = (lo / LON_STEPS) * Math.PI * 2;
        if (!land(theta, phi)) continue;
        const x3 = ringRadius * Math.cos(theta + rotation);
        const z3 = ringRadius * Math.sin(theta + rotation);
        if (z3 <= 0.02) continue; // back-face cull
        const px = cx + x3 * radius;
        const py = cy - y * radius;
        const dotAlpha = 0.35 + z3 * 0.65;
        ctx.globalAlpha = alpha * dotAlpha;
        const size = 1.1 + z3 * 1.3;
        ctx.beginPath();
        ctx.arc(px, py, size, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // crosshair reticle
    ctx.globalAlpha = alpha * 0.5;
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    const chLen = 14;
    const chR = radius * 1.5;
    [0, Math.PI / 2, Math.PI, Math.PI * 1.5].forEach((a) => {
      const x1 = cx + Math.cos(a) * chR;
      const y1 = cy + Math.sin(a) * chR;
      const x2 = cx + Math.cos(a) * (chR - chLen);
      const y2 = cy + Math.sin(a) * (chR - chLen);
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    });

    ctx.restore();
  }

  interface Particle { x: number; y: number; vx: number; vy: number; life: number; size: number }
  let particles: Particle[] = [];
  function spawnParticles(cx: number, cy: number) {
    particles = [];
    const n = 90;
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2;
      const speed = 1.5 + Math.random() * 5;
      particles.push({
        x: cx, y: cy,
        vx: Math.cos(a) * speed,
        vy: Math.sin(a) * speed,
        life: 1,
        size: 1 + Math.random() * 2.2,
      });
    }
  }
  function drawParticles(alpha: number) {
    ctx.save();
    ctx.fillStyle = '#fff';
    particles.forEach((p) => {
      p.x += p.vx; p.y += p.vy; p.vx *= 0.98; p.vy *= 0.98; p.life -= 0.018;
      if (p.life <= 0) return;
      ctx.globalAlpha = Math.max(0, p.life) * alpha;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.restore();
  }

  function finish() {
    if (finished) return;
    finished = true;
    overlay!.classList.add('fade-out');
    document.documentElement.classList.remove('intro-locked');
    window.removeEventListener('resize', resize);
    cancelAnimationFrame(raf);
    setTimeout(() => overlay?.remove(), FADE_DUR + 50);
  }

  function skip() {
    if (finished) return;
    finish();
  }
  skipBtn?.addEventListener('click', skip);
  overlay.addEventListener('click', skip);
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') skip(); });

  function loop(now: number) {
    if (finished) return;
    ctx.clearRect(0, 0, w, h);
    const cx = w / 2, cy = h / 2;
    const baseRadius = Math.min(w, h) * 0.16;
    const elapsed = now - start;

    if (phase === 'globe') {
      const rotation = elapsed * 0.0006;
      drawGlobe(now, rotation, baseRadius, cx, cy, 1);
      if (elapsed >= ZOOM_AT) {
        phase = 'zoom';
        phaseStart = now;
        content?.classList.add('hide');
        spawnParticles(cx, cy);
      }
    } else if (phase === 'zoom') {
      const p = Math.min(1, (now - phaseStart) / EXPLODE_DUR);
      const rotation = elapsed * 0.0006;
      const scale = 1 + p * 2.4;
      const globeAlpha = 1 - p;
      drawGlobe(now, rotation, baseRadius * (1 - p * 0.4), cx, cy, globeAlpha * 0.6);
      drawParticles(1);
      // grain flash
      if (p < 1) {
        ctx.save();
        ctx.globalAlpha = 0.05 * (1 - p);
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, w, h);
        ctx.restore();
      }
      if (p >= 1) {
        phase = 'done';
        finish();
      }
    }

    raf = requestAnimationFrame(loop);
  }
  raf = requestAnimationFrame(loop);
})();
</script>

<style is:global>
html.intro-locked{overflow:hidden}
</style>
