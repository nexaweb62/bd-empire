---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contact — BD EMPIRES" description="Contactez l'équipe BD EMPIRES.">
<style>
.contact-page{padding:60px 0 100px}
.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:56px}
.contact-layout h1{font-size:clamp(2rem,4vw,2.8rem)}
.contact-layout p{color:var(--text-muted);margin-top:16px;line-height:1.6;max-width:420px}
.form{padding:30px}
.field{margin-bottom:18px}
.field label{display:block;font-size:.76rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:8px}
.field input,.field textarea{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--border);color:var(--text);font-family:inherit;font-size:.9rem}
.field textarea{resize:vertical;min-height:120px}
@media(max-width:820px){.contact-layout{grid-template-columns:1fr}}
</style>
<Header />
<main>
  <section class="contact-page">
    <div class="wrap contact-layout">
      <div>
        <span class="label">Contact</span>
        <h1 class="display" style="margin-top:14px">Une question,<br>une commande spéciale ?</h1>
        <p>Notre équipe vous répond sous 24h ouvrées. Pour un article en rupture ou une précommande, précisez-le dans votre message.</p>
      </div>
      <form class="card form">
        <div class="field">
          <label for="name">Nom</label>
          <input id="name" type="text" placeholder="Votre nom" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" placeholder="vous@exemple.com" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" placeholder="Votre message..."></textarea>
        </div>
        <button type="submit" class="btn" style="width:100%">Envoyer</button>
      </form>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
