---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';

const similaires = [
  { title: 'Nike Air Max Plus (Black)', price: '170,00 €' },
  { title: 'Nike Air Max Plus VII 7 Black', price: '170,00 €' },
  { title: 'Nike Pegasus Premium (Barely Green)', price: '200,00 €' },
];
---
<BaseLayout title="Nike Aeroswift Therma-Fit ADV — BD EMPIRES" description="Fiche produit exemple pour la maquette BD EMPIRES.">
<style>
.p-page{padding:50px 0 100px}
.p-layout{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:start}
.p-cover-lg{aspect-ratio:1/1;background:var(--panel)}
.p-title{font-size:clamp(1.6rem,2.8vw,2.1rem);margin-top:14px}
.p-price-row{display:flex;align-items:center;gap:14px;margin-top:20px}
.p-price{font-size:1.3rem;font-weight:600}
.p-stock{font-size:.78rem;color:#3f7a4d;font-weight:600}
.p-desc{margin-top:24px;color:var(--text-muted);line-height:1.75;font-size:.92rem;max-width:480px}
.p-qty{display:flex;align-items:center;gap:14px;margin-top:28px}
.qty-box{display:flex;align-items:center;border:1px solid var(--border)}
.qty-box button{width:36px;height:40px;background:transparent;border:none;color:var(--text);font-size:1rem;cursor:pointer}
.qty-box span{width:32px;text-align:center;font-weight:600;font-size:.9rem}
.p-actions{margin-top:26px;display:flex;gap:14px;flex-wrap:wrap}
.p-actions .btn,.p-actions .btn-outline{flex:1;min-width:180px}
.related{padding:70px 0 100px;border-top:1px solid var(--border)}
.related h2{font-size:1.4rem;margin-bottom:26px}
.p-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
@media(max-width:820px){.p-layout{grid-template-columns:1fr}.p-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.p-grid{grid-template-columns:1fr}}
</style>
<Header />
<main>
  <section class="p-page">
    <div class="wrap p-layout">
      <div class="p-cover-lg"></div>
      <div>
        <span class="label">Vêtements</span>
        <h1 class="p-title">Nike Aeroswift Therma-Fit ADV — Longue manche</h1>
        <div class="p-price-row">
          <span class="p-price">220,00 €</span>
          <span class="p-stock">En stock</span>
        </div>
        <p class="p-desc">Veste technique longue manche, coupe ajustée, matière Therma-Fit ADV pour une isolation légère sans surchauffe. Pièce d'entraînement polyvalente, du running au quotidien.</p>
        <div class="p-qty">
          <div class="qty-box">
            <button type="button" aria-label="Diminuer la quantité">−</button>
            <span>1</span>
            <button type="button" aria-label="Augmenter la quantité">+</button>
          </div>
        </div>
        <div class="p-actions">
          <button type="button" class="btn">Ajouter au panier</button>
          <a href="/panier" class="btn-outline btn">Voir le panier</a>
        </div>
      </div>
    </div>
  </section>

  <section class="related">
    <div class="wrap">
      <h2 class="display">Vous aimerez aussi</h2>
      <div class="p-grid">{similaires.map((p) => <ProductCard {...p} />)}</div>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
