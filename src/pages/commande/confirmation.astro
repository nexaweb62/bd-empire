---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Commande confirmée — BD Empires" description="Votre commande BD Empires est confirmée.">
<style>
.confirm{padding:calc(var(--hdr) + 80px) 0 120px;text-align:center}
.confirm .eyebrow{display:block;margin-bottom:18px}
.confirm h1{font-family:'Archivo Black',sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);max-width:560px;margin:0 auto}
.order-number{margin-top:22px;font-size:1.1rem;font-weight:700}
.confirm p.sub{color:var(--text-muted);margin-top:16px;max-width:440px;margin-left:auto;margin-right:auto}
.confirm .btn{margin-top:36px}
</style>
<Header />
<main>
  <section class="confirm">
    <div class="wrap">
      <span class="eyebrow">Commande confirmée</span>
      <h1>Merci. On s'occupe du reste.</h1>
      <p class="order-number" id="order-number"></p>
      <p class="sub">Un email de confirmation vous a été envoyé. Vous recevrez un lien de suivi dès l'expédition.</p>
      <a href="/boutique" class="btn">Retour à la boutique</a>
    </div>
  </section>
</main>
<Footer />
<script>
  const params = new URLSearchParams(window.location.search);
  const n = params.get('n') || localStorage.getItem('bdEmpiresLastOrder') || '—';
  document.getElementById('order-number')!.textContent = `Commande n° ${n}`;
</script>
</BaseLayout>
