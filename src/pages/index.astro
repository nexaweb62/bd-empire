---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';

const collection = [
  { title: 'Coque BD EMPIRES', price: '20,00 €' },
  { title: 'FORMATION BD EMPIRES', price: '150,00 €', oldPrice: '280,00 €', badge: 'Promotion' },
  { title: 'Legging Nike taille haute (ZENVY)', price: '65,00 €' },
  { title: 'Leggings Nike One', price: '55,00 €' },
  { title: 'Mitzuno Wave Prophecy LS', price: '250,00 €' },
  { title: 'Nike Aeroswift Therma-Fit ADV', price: '220,00 €' },
];
---
<BaseLayout title="BD EMPIRES — Vêtements, sneakers & accessoires streetwear">
<style>
.hero{display:grid;grid-template-columns:0.75fr 1fr}
.hero-panel{position:relative;aspect-ratio:4/5;background:var(--panel);display:flex;align-items:flex-end;overflow:hidden}
.hero-panel.right{aspect-ratio:auto}
.hero-copy{position:relative;padding:44px;color:#fff}
.hero-panel::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgb(0 0 0 / .55),transparent 55%)}
.hero-copy{z-index:1}
.hero-copy h1{font-size:clamp(2.6rem,5vw,4.4rem);color:#fff}
.hero-copy p{margin-top:8px;font-size:.9rem;opacity:.85}
.hero-copy .btn{margin-top:22px;background:#fff;color:#141311;border-color:#fff}
.hero-copy .btn:hover{background:transparent;color:#fff}
@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-panel.right{aspect-ratio:4/5}}

.collection{padding:80px 0 100px}
.section-h{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:32px}
.section-h h2{font-size:clamp(1.6rem,2.6vw,2.2rem)}
.section-h a{font-size:.82rem;font-weight:600;text-decoration:underline;text-underline-offset:3px}
.p-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:22px}
@media(max-width:1100px){.p-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.p-grid{grid-template-columns:repeat(2,1fr)}}
</style>

<Header />
<main>
  <section class="hero">
    <div class="hero-panel">
      <div class="hero-copy">
        <h1 class="display">Nouveautés</h1>
        <p>Disponible</p>
        <a href="/catalogue" class="btn">Acheter maintenant</a>
      </div>
    </div>
    <div class="hero-panel right"></div>
  </section>

  <section class="collection">
    <div class="wrap">
      <div class="section-h">
        <h2 class="display">Collection BD EMPIRES</h2>
        <a href="/catalogue">Voir toute la collection</a>
      </div>
      <div class="p-grid">
        {collection.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
