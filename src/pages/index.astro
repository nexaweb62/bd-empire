---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import Countdown from '../components/Countdown.astro';
import { products } from '../data/products';

const featured = products.filter((p) => ['hoodie-empire-400', 'bomber-360', 'cargo-respect', 'crewneck-orbit'].includes(p.slug));
const dropDate = new Date();
dropDate.setDate(dropDate.getDate() + 6);
dropDate.setHours(20, 0, 0, 0);
---
<BaseLayout title="BD Empires — By La Mentale" description="Vêtements streetwear en séries limitées. Work. Respect. Discipline.">
<style>
.hero{
  min-height:100svh;position:relative;display:flex;align-items:flex-end;
  background:radial-gradient(circle at 30% 20%,#141416,#000 65%);
  border-bottom:1px solid var(--border);
}
.hero-in{padding:0 0 64px;position:relative;z-index:1}
.hero-in .display{font-size:clamp(2.6rem,9vw,6.5rem)}
.hero-in .signature{font-size:clamp(1.2rem,4vw,2.2rem);margin-top:8px}
.hero-eyebrow{margin-bottom:18px}

.marquee-wrap{border-bottom:1px solid var(--border);overflow:hidden;background:#000}
.marquee{display:flex;white-space:nowrap;padding:14px 0;animation:marquee 22s linear infinite}
.marquee span{font-family:'Archivo Black',sans-serif;font-size:.82rem;letter-spacing:.18em;text-transform:uppercase;padding:0 28px;color:var(--text-muted)}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion: reduce){.marquee{animation:none}}

.section{padding:88px 0}
.section-h{margin-bottom:40px}
.section-h .eyebrow{display:block;margin-bottom:10px}
.section-h h2{font-family:'Archivo Black',sans-serif;font-size:clamp(1.6rem,3vw,2.4rem)}
.p-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
@media(max-width:980px){.p-grid{grid-template-columns:repeat(2,1fr)}}

.drop{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:88px 0;background:var(--surface)}
.drop-layout{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:40px}
.drop-copy h2{font-family:'Archivo Black',sans-serif;font-size:clamp(1.8rem,3.4vw,2.8rem);max-width:520px}
.drop-copy p{color:var(--text-muted);margin-top:14px;max-width:440px;font-size:.9rem;line-height:1.7}

.manifesto{max-width:760px}
.manifesto p{font-size:clamp(1.1rem,2vw,1.5rem);line-height:1.5;margin:0 0 28px;color:var(--text)}
.manifesto p:last-child{margin-bottom:0}

.lookbook-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.lb-panel{aspect-ratio:4/5;background:var(--surface)}
@media(max-width:820px){.lookbook-grid{grid-template-columns:1fr 1fr}.lb-panel:nth-child(3){display:none}}

.newsletter{padding:88px 0;text-align:center}
.newsletter h2{font-family:'Archivo Black',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);max-width:520px;margin:0 auto 24px}
.nl-form{display:flex;gap:0;max-width:440px;margin:0 auto;border:1px solid var(--border)}
.nl-form input{flex:1;background:transparent;border:none;color:#fff;padding:16px;font-size:.88rem}
.nl-form input:focus{outline:none}
.nl-form button{border:none;background:#fff;color:#000;padding:0 22px;font-weight:700;font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
</style>

<Header />
<main>
  <section class="hero grain">
    <div class="wrap hero-in">
      <span class="eyebrow hero-eyebrow">Nouvelle série — disponible maintenant</span>
      <h1 class="display">BD Empires</h1>
      <p class="signature">By La Mentale</p>
    </div>
  </section>

  <div class="marquee-wrap">
    <div class="marquee">
      <span>Work · Respect · Discipline</span><span>Work · Respect · Discipline</span>
      <span>Work · Respect · Discipline</span><span>Work · Respect · Discipline</span>
      <span>Work · Respect · Discipline</span><span>Work · Respect · Discipline</span>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-h">
        <span class="eyebrow">Sélection</span>
        <h2>Quatre pièces</h2>
      </div>
      <div class="p-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="drop">
    <div class="wrap drop-layout">
      <div class="drop-copy">
        <span class="eyebrow">Prochain drop</span>
        <h2>Série 004 — nombre de pièces limité, aucun réassort.</h2>
        <p>Chaque drop sort une fois, en quantité fixe. Une fois écoulé, la pièce ne revient pas. Active les alertes pour ne pas la manquer.</p>
      </div>
      <Countdown target={dropDate.toISOString()} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-h">
        <span class="eyebrow">Manifeste</span>
        <h2>Ce qu'on défend</h2>
      </div>
      <div class="manifesto">
        <p>On n'a jamais eu de mentor. On a eu la rue, les refus, et le temps qu'il fallait pour apprendre à se taire et faire.</p>
        <p>Chaque pièce sort en petite série. Pas de réassort automatique, pas de promesse qu'on ne peut pas tenir. Ce qui part, part.</p>
        <p>Trois mots nous suffisent : Work. Respect. Discipline. Le reste, c'est du bruit.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-h">
        <span class="eyebrow">Lookbook</span>
        <h2>Série 003</h2>
      </div>
      <div class="lookbook-grid">
        <a href="/lookbook" class="lb-panel grain"></a>
        <a href="/lookbook" class="lb-panel grain"></a>
        <a href="/lookbook" class="lb-panel grain"></a>
      </div>
    </div>
  </section>

  <section class="newsletter">
    <div class="wrap">
      <h2>Sois informé avant tout le monde du prochain drop.</h2>
      <form class="nl-form">
        <input type="email" placeholder="Votre email" required aria-label="Adresse email" />
        <button type="submit">S'inscrire</button>
      </form>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
