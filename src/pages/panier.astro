---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Panier — BD Empires" description="Votre panier BD Empires.">
<style>
.cart-page{padding:calc(var(--hdr) + 40px) 0 100px}
.cart-page h1{font-family:'Archivo Black',sans-serif;font-size:clamp(1.8rem,3.4vw,2.4rem)}
.cart-layout{display:grid;grid-template-columns:1.6fr 1fr;gap:40px;align-items:start;margin-top:36px}
.cart-item{display:flex;gap:16px;padding:20px 0;align-items:flex-start}
.cart-item + .cart-item{border-top:1px solid var(--border)}
.ci-cover{width:80px;height:100px;flex-shrink:0;background:var(--surface)}
.ci-name{font-weight:600;font-size:.92rem}
.ci-size{font-size:.8rem;color:var(--text-muted);margin-top:4px}
.ci-qty{display:flex;align-items:center;gap:10px;margin-top:12px}
.ci-qty button{background:none;border:1px solid var(--border);color:#fff;width:26px;height:26px;cursor:pointer}
.ci-remove{margin-top:10px;background:none;border:none;color:var(--text-tertiary);font-size:.74rem;text-decoration:underline;cursor:pointer;padding:0}
.ci-price{margin-left:auto;font-weight:700}
.summary{padding:24px}
.summary h2{font-family:'Archivo Black',sans-serif;font-size:1rem;margin-bottom:20px}
.sum-row{display:flex;justify-content:space-between;font-size:.88rem;color:var(--text-muted);margin-bottom:12px}
.sum-total{display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}
.promo-row{display:flex;gap:8px;margin:18px 0}
.promo-row input{flex:1;background:transparent;border:1px solid var(--border);color:#fff;padding:10px 12px;font-size:.82rem}
.promo-row button{border:1px solid var(--border);background:transparent;color:#fff;padding:0 14px;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;cursor:pointer}
.promo-msg{font-size:.76rem;margin-top:-8px;margin-bottom:14px}
.promo-msg.ok{color:#9fd39f}
.promo-msg.err{color:var(--error)}
.cart-empty{padding:80px 0;text-align:center;color:var(--text-muted)}
@media(max-width:820px){.cart-layout{grid-template-columns:1fr}}
</style>
<Header />
<main>
  <section class="cart-page">
    <div class="wrap">
      <span class="eyebrow">Étape 1 sur 3</span>
      <h1 style="margin-top:14px">Votre panier</h1>

      <div id="cart-loaded" hidden>
        <div class="cart-layout">
          <div class="card" id="cart-lines"></div>
          <div class="card summary">
            <h2>Résumé</h2>
            <div class="promo-row">
              <input type="text" id="promo-input" placeholder="Code promo" />
              <button type="button" id="promo-apply">Appliquer</button>
            </div>
            <p class="promo-msg" id="promo-msg"></p>
            <div class="sum-row"><span>Sous-total</span><span id="sum-subtotal">0,00 €</span></div>
            <div class="sum-row"><span>Livraison estimée</span><span id="sum-shipping">4,90 €</span></div>
            <div class="sum-total"><span>Total</span><span id="sum-total">0,00 €</span></div>
            <a href="/commande" class="btn" style="width:100%;margin-top:20px">Commander</a>
          </div>
        </div>
      </div>
      <div class="cart-empty" id="cart-empty" hidden>
        <p>Votre panier est vide.</p>
        <a href="/boutique" class="btn" style="margin-top:20px">Voir la boutique</a>
      </div>
    </div>
  </section>
</main>
<Footer />

<script>
  import { getCart, cartSubtotal, updateQty } from '../lib/cart';

  const fmt = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
  const SHIPPING = 4.9;
  let promoApplied = false;

  function render() {
    const cart = getCart();
    const loaded = document.getElementById('cart-loaded')!;
    const empty = document.getElementById('cart-empty')!;

    if (cart.length === 0) {
      loaded.hidden = true;
      empty.hidden = false;
      return;
    }
    loaded.hidden = false;
    empty.hidden = true;

    const linesEl = document.getElementById('cart-lines')!;
    linesEl.innerHTML = cart.map((l) => `
      <div class="cart-item" data-slug="${l.slug}" data-size="${l.size}">
        <div class="ci-cover"></div>
        <div>
          <div class="ci-name">${l.name}</div>
          <div class="ci-size">Taille ${l.size}</div>
          <div class="ci-qty">
            <button type="button" data-action="dec">−</button>
            <span>${l.qty}</span>
            <button type="button" data-action="inc">+</button>
          </div>
          <button type="button" class="ci-remove" data-action="remove">Retirer</button>
        </div>
        <div class="ci-price">${fmt(l.price * l.qty)}</div>
      </div>
    `).join('');

    linesEl.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const itemEl = (e.currentTarget as HTMLElement).closest('.cart-item') as HTMLElement;
        const slug = itemEl.dataset.slug!;
        const size = itemEl.dataset.size!;
        const action = (e.currentTarget as HTMLElement).dataset.action;
        const line = cart.find((l) => l.slug === slug && l.size === size);
        if (!line) return;
        if (action === 'remove') updateQty(slug, size, 0);
        else updateQty(slug, size, line.qty + (action === 'inc' ? 1 : -1));
      });
    });

    const subtotal = cartSubtotal(cart);
    const discount = promoApplied ? subtotal * 0.1 : 0;
    const total = subtotal - discount + SHIPPING;
    document.getElementById('sum-subtotal')!.textContent = fmt(subtotal);
    document.getElementById('sum-total')!.textContent = fmt(total);
  }

  document.getElementById('promo-apply')?.addEventListener('click', () => {
    const input = document.getElementById('promo-input') as HTMLInputElement;
    const msg = document.getElementById('promo-msg')!;
    if (input.value.trim().toUpperCase() === 'DISCIPLINE10') {
      promoApplied = true;
      msg.textContent = 'Code appliqué — 10% de réduction.';
      msg.className = 'promo-msg ok';
    } else {
      promoApplied = false;
      msg.textContent = 'Code promo invalide.';
      msg.className = 'promo-msg err';
    }
    render();
  });

  window.addEventListener('cart:change', render);
  render();
</script>
</BaseLayout>
