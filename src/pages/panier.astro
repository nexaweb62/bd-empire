---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const items = [
  { title: 'Nike Aeroswift Therma-Fit ADV', price: 220.00, qty: 1 },
  { title: 'Coque BD EMPIRES', price: 20.00, qty: 2 },
];
const sousTotal = items.reduce((sum, i) => sum + i.price * i.qty, 0);
const livraison = 4.90;
const total = sousTotal + livraison;
const fmt = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
---
<BaseLayout title="Panier — BD EMPIRES" description="Votre panier BD EMPIRES.">
<style>
.cart-page{padding:50px 0 100px}
.cart-layout{display:grid;grid-template-columns:1.6fr 1fr;gap:40px;align-items:start}
.cart-item{display:flex;gap:16px;padding:18px;align-items:center}
.cart-item + .cart-item{border-top:1px solid var(--border)}
.ci-cover{width:64px;height:80px;flex-shrink:0;background:var(--panel)}
.ci-title{font-weight:500;font-size:.9rem}
.ci-qty{margin-top:6px;font-size:.8rem;color:var(--text-muted)}
.ci-price{margin-left:auto;font-weight:600}
.summary{padding:24px}
.summary h2{font-size:1.1rem;margin-bottom:18px}
.sum-row{display:flex;justify-content:space-between;font-size:.88rem;color:var(--text-muted);margin-bottom:10px}
.sum-total{display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)}
@media(max-width:820px){.cart-layout{grid-template-columns:1fr}}
</style>
<Header />
<main>
  <section class="cart-page">
    <div class="wrap">
      <span class="label">Étape 1 sur 3</span>
      <h1 class="display" style="margin-top:14px;font-size:clamp(1.8rem,3.4vw,2.4rem)">Votre panier</h1>

      <div class="cart-layout" style="margin-top:36px">
        <div class="card">
          {items.map((i) => (
            <div class="cart-item">
              <div class="ci-cover"></div>
              <div>
                <p class="ci-title">{i.title}</p>
                <p class="ci-qty">Quantité : {i.qty}</p>
              </div>
              <span class="ci-price">{fmt(i.price * i.qty)}</span>
            </div>
          ))}
        </div>

        <div class="card summary">
          <h2>Résumé</h2>
          <div class="sum-row"><span>Sous-total</span><span>{fmt(sousTotal)}</span></div>
          <div class="sum-row"><span>Livraison</span><span>{fmt(livraison)}</span></div>
          <div class="sum-total"><span>Total</span><span>{fmt(total)}</span></div>
          <a href="/contact" class="btn" style="width:100%;margin-top:22px">Passer commande</a>
        </div>
      </div>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
