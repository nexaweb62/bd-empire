---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---
<BaseLayout title="Boutique — BD Empires" description="Tous les articles BD Empires : hauts, bas, vestes et accessoires en séries limitées.">
<style>
.shop-hero{padding:calc(var(--hdr) + 40px) 0 0}
.shop-hero h1{font-family:'Archivo Black',sans-serif;font-size:clamp(1.8rem,3.4vw,2.6rem)}
.filter-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:26px 0;border-bottom:1px solid var(--border);margin-top:24px}
.filter-left,.filter-right{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.filter-select{position:relative}
.filter-btn{display:flex;align-items:center;gap:6px;font-size:.78rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:none;border:none;cursor:pointer;color:var(--text)}
.filter-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2}
.filter-panel{
  position:absolute;top:100%;left:0;margin-top:10px;background:#000;border:1px solid var(--border);
  padding:16px;min-width:180px;display:none;flex-direction:column;gap:10px;z-index:5;
}
.filter-select.open .filter-panel{display:flex}
.filter-panel label{display:flex;align-items:center;gap:8px;font-size:.82rem;cursor:pointer}
.filter-count{font-size:.78rem;color:var(--text-muted)}
.result-empty{padding:80px 0;text-align:center;color:var(--text-muted)}
.cat-grid-wrap{padding:36px 0 60px}
.p-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 20px}
.load-more{display:flex;justify-content:center;padding:20px 0 100px}
@media(max-width:1100px){.p-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.p-grid{grid-template-columns:repeat(2,1fr)}}
</style>
<Header />
<main>
  <section class="shop-hero">
    <div class="wrap">
      <span class="eyebrow">12 pièces</span>
      <h1 style="margin-top:10px">Boutique</h1>

      <div class="filter-bar">
        <div class="filter-left">
          <div class="filter-select" data-filter="category">
            <button type="button" class="filter-btn">Catégorie <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
            <div class="filter-panel">
              {['Hauts', 'Bas', 'Vestes', 'Accessoires'].map((c) => (
                <label><input type="checkbox" name="category" value={c} /> {c}</label>
              ))}
            </div>
          </div>
          <div class="filter-select" data-filter="size">
            <button type="button" class="filter-btn">Taille <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
            <div class="filter-panel">
              {['S', 'M', 'L', 'XL', 'XXL'].map((s) => (
                <label><input type="checkbox" name="size" value={s} /> {s}</label>
              ))}
            </div>
          </div>
          <div class="filter-select" data-filter="avail">
            <button type="button" class="filter-btn">Disponibilité <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
            <div class="filter-panel">
              <label><input type="checkbox" name="avail" value="in-stock" /> En stock</label>
              <label><input type="checkbox" name="avail" value="limited" /> Série limitée</label>
            </div>
          </div>
        </div>
        <div class="filter-right">
          <span class="filter-count" id="result-count">{products.length} articles</span>
          <div class="filter-select" data-filter="sort">
            <button type="button" class="filter-btn">Trier <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
            <div class="filter-panel">
              <label><input type="radio" name="sort" value="default" checked /> Pertinence</label>
              <label><input type="radio" name="sort" value="price-asc" /> Prix croissant</label>
              <label><input type="radio" name="sort" value="price-desc" /> Prix décroissant</label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cat-grid-wrap">
    <div class="wrap">
      <div class="p-grid" id="p-grid">
        {products.map((p) => (
          <div
            class="p-grid-item"
            data-category={p.category}
            data-sizes={p.variants.filter((v) => v.stock > 0).map((v) => v.size).join(',')}
            data-price={p.price}
            data-limited={p.limited ? '1' : '0'}
            data-instock={p.variants.some((v) => v.stock > 0) ? '1' : '0'}
          >
            <ProductCard product={p} />
          </div>
        ))}
      </div>
      <p class="result-empty" id="result-empty" hidden>Aucun article ne correspond à ces filtres.</p>
    </div>
  </section>
</main>
<Footer />

<script>
  document.querySelectorAll<HTMLElement>('.filter-select').forEach((sel) => {
    const btn = sel.querySelector('.filter-btn');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = sel.classList.contains('open');
      document.querySelectorAll('.filter-select.open').forEach((s) => s.classList.remove('open'));
      if (!wasOpen) sel.classList.add('open');
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.filter-select.open').forEach((s) => s.classList.remove('open'));
  });

  const grid = document.getElementById('p-grid')!;
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.p-grid-item'));
  const countEl = document.getElementById('result-count')!;
  const emptyEl = document.getElementById('result-empty')!;

  function checkedValues(name: string) {
    return Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((i) => i.value);
  }

  function applyFilters() {
    const categories = checkedValues('category');
    const sizes = checkedValues('size');
    const avail = checkedValues('avail');
    const sort = (document.querySelector('input[name="sort"]:checked') as HTMLInputElement)?.value || 'default';

    let visible = 0;
    items.forEach((item) => {
      const cat = item.dataset.category!;
      const itemSizes = (item.dataset.sizes || '').split(',');
      const inStock = item.dataset.instock === '1';
      const limited = item.dataset.limited === '1';

      let ok = true;
      if (categories.length && !categories.includes(cat)) ok = false;
      if (sizes.length && !sizes.some((s) => itemSizes.includes(s))) ok = false;
      if (avail.includes('in-stock') && !inStock) ok = false;
      if (avail.includes('limited') && !limited) ok = false;

      item.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });

    if (sort !== 'default') {
      const sorted = items.filter((i) => i.style.display !== 'none')
        .sort((a, b) => {
          const pa = Number(a.dataset.price), pb = Number(b.dataset.price);
          return sort === 'price-asc' ? pa - pb : pb - pa;
        });
      sorted.forEach((el) => grid.appendChild(el));
    }

    countEl.textContent = `${visible} article${visible > 1 ? 's' : ''}`;
    emptyEl.hidden = visible !== 0;
  }

  document.querySelectorAll('input[name="category"], input[name="size"], input[name="avail"], input[name="sort"]').forEach((input) => {
    input.addEventListener('change', applyFilters);
  });
</script>
</BaseLayout>
